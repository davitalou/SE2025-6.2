<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title><%= title || "App Backend" %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
</head>
<body class="d-flex flex-column h-100">

<header>
  <nav class="navbar navbar-expand-md navbar-dark bg-dark fixed-top">
    <a class="navbar-brand" href="/">App Backend</a>
    <div class="collapse navbar-collapse">
      <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
      </ul>
    </div>
  </nav>
</header>

<main role="main" class="flex-shrink-0" style="margin-top:80px;">
  <div class="container">
    <%- body %>
  </div>
</main>

<footer class="footer mt-auto py-3 text-muted">
  <div class="container">
    <p class="float-left">&copy; <%= new Date().getFullYear() %> App Backend</p>
    <p class="float-right">Powered by Node.js + EJS</p>
  </div>
</footer>

</body>
</html>
