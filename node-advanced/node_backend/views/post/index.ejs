<div class="row">
  <div class="col-12">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1>Posts</h1>
      <% if (user) { %>
        <a href="/post/create" class="btn btn-primary">Create Post</a>
      <% } %>
    </div>
    
    <% if (posts && posts.length > 0) { %>
      <% posts.forEach(post => { %>
        <div class="card mb-3">
          <div class="card-body">
            <h5 class="card-title">
              <a href="/post/<%= post.id %>"><%= post.title %></a>
            </h5>
            <p class="card-text">
              <%= post.body.length > 300 ? post.body.substring(0, 300) + '...' : post.body %>
            </p>
            <p class="card-text">
              <small class="text-muted">
                By <%= post.author ? post.author.username : 'Unknown' %> 
                on <%= new Date(post.created_at * 1000).toLocaleDateString() %>
              </small>
            </p>
          </div>
        </div>
      <% }); %>
      
      <% if (totalPages > 1) { %>
        <nav aria-label="Posts pagination">
          <ul class="pagination justify-content-center">
            <% if (hasPrevPage) { %>
              <li class="page-item">
                <a class="page-link" href="/post?page=<%= prevPage %>">Previous</a>
              </li>
            <% } %>
            
            <% for (let i = 1; i <= totalPages; i++) { %>
              <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                <a class="page-link" href="/post?page=<%= i %>"><%= i %></a>
              </li>
            <% } %>
            
            <% if (hasNextPage) { %>
              <li class="page-item">
                <a class="page-link" href="/post?page=<%= nextPage %>">Next</a>
              </li>
            <% } %>
          </ul>
        </nav>
      <% } %>
    <% } else { %>
      <div class="text-center">
        <p class="lead">No posts found.</p>
        <% if (user) { %>
          <a href="/post/create" class="btn btn-primary">Create First Post</a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
