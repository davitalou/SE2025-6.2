<div class="row">
  <div class="col-12">
    <div class="card mb-4">
      <div class="card-body">
        <h1 class="card-title"><%= post.title %></h1>
        <p class="card-text">
          <small class="text-muted">
            By <%= post.author ? post.author.username : 'Unknown' %> 
            on <%= new Date(post.created_at * 1000).toLocaleDateString() %>
          </small>
        </p>
        <div class="card-text">
          <%= post.body.replace(/\n/g, '<br>') %>
        </div>
        
        <% if (user && user.id === post.created_by) { %>
          <div class="mt-3">
            <a href="/post/<%= post.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
            <form method="post" action="/post/<%= post.id %>/delete" class="d-inline">
              <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this post?')">Delete</button>
            </form>
          </div>
        <% } %>
      </div>
    </div>
    
    <!-- Comments Section -->
    <div class="card">
      <div class="card-header">
        <h5>Comments (<%= comments ? comments.length : 0 %>)</h5>
      </div>
      <div class="card-body">
        <% if (comments && comments.length > 0) { %>
          <% comments.forEach(comment => { %>
            <div class="mb-3">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <strong><%= comment.author ? comment.author.username : 'Unknown' %></strong>
                  <small class="text-muted ms-2">
                    <%= new Date(comment.created_at * 1000).toLocaleDateString() %>
                  </small>
                </div>
                <% if (user && user.id === comment.created_by) { %>
                  <div>
                    <a href="/comment/<%= comment.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form method="post" action="/comment/<%= comment.id %>/delete" class="d-inline">
                      <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this comment?')">Delete</button>
                    </form>
                  </div>
                <% } %>
              </div>
              <p class="mt-2"><%= comment.body.replace(/\n/g, '<br>') %></p>
            </div>
            <hr>
          <% }); %>
        <% } else { %>
          <p class="text-muted">No comments yet.</p>
        <% } %>
        
        <!-- Add Comment Form -->
        <% if (user) { %>
          <form method="post" action="/comment/create">
            <input type="hidden" name="post_id" value="<%= post.id %>">
            <div class="mb-3">
              <label for="body" class="form-label">Add Comment</label>
              <textarea class="form-control" id="body" name="body" rows="3" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Add Comment</button>
          </form>
        <% } else { %>
          <p class="text-muted">Please <a href="/login">login</a> to add comments.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>
