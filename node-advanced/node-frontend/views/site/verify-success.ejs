<%
  const MESSAGE = message ?? "Email verified successfully!";
%>

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
  <div class="card shadow-lg border-0 rounded-4 p-5 text-center" style="max-width: 480px;">
    <div class="mb-4">
      <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
    </div>
    <h1 class="text-success mb-3">Xác minh email thành công!</h1>
    <p class="text-muted fs-5"><%= MESSAGE %></p>
    <a href="/login" class="btn btn-primary btn-lg mt-4 px-4">
      <i class="bi bi-box-arrow-in-right me-2"></i> Đăng nhập ngay
    </a>
  </div>
</div>
