<div class="site-contact mt-4">
  <h1>Contact</h1>
  <p>If you have inquiries, please send us a message.</p>

  <% if (typeof alert !== "undefined" && alert) { %>
    <%- include("../partials/alert", { alert }) %>
  <% } %>

  <form action="/contact" method="POST">
    <div class="form-group">
      <label>Your Name</label>
      <input class="form-control" name="name" value="<%= formData?.name || '' %>" required>
    </div>
    <div class="form-group">
      <label>Your Email</label>
      <input class="form-control" type="email" name="email" value="<%= formData?.email || '' %>" required>
    </div>
    <div class="form-group">
      <label>Subject</label>
      <input class="form-control" name="subject" value="<%= formData?.subject || '' %>" required>
    </div>
    <div class="form-group">
      <label>Message</label>
      <textarea class="form-control" name="message" rows="5" required><%= formData?.message || '' %></textarea>
    </div>
    <button class="btn btn-primary mt-2">Send</button>
  </form>
</div>
